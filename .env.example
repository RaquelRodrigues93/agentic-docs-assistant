# Copy to .env and fill in. Never commit .env.
# Settings marked (Phase N) are read once that phase is implemented.

ENVIRONMENT=local
LOG_LEVEL=INFO
LOG_JSON=false

# --- Retrieval ---
QDRANT_URL=http://localhost:6333
# QDRANT_COLLECTION=docs                          # (Phase 1)
# EMBEDDINGS_PROVIDER=fastembed                   # fastembed | bedrock  (Phase 1)
# EMBEDDINGS_MODEL=BAAI/bge-small-en-v1.5         # (Phase 1)

# --- LLM provider (Phase 1) ---
# LLM_PROVIDER=ollama                             # bedrock | ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen3:8b
# AWS_REGION=us-east-1
# BEDROCK_MODEL_ID=                               # Claude Sonnet inference profile ID; verify with
#                                                 # `aws bedrock list-inference-profiles --region us-east-1`
# JUDGE_MODEL_ID=                                 # Claude Haiku inference profile ID (evals)
# AWS_PROFILE=                                    # or AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY

# --- MCP / GitHub (Phase 2) ---
# MCP_SERVER_URL=http://localhost:8001/mcp
# GITHUB_REPO=<owner>/agentic-docs-assistant-sandbox
# GITHUB_TOKEN=                                   # fine-grained PAT: Issues read/write on GITHUB_REPO only
# GITHUB_DRY_RUN=true                             # true = never call GitHub, return the drafted payload

# --- Observability (Phase 3) ---
# TRACING_BACKEND=phoenix                         # phoenix | langsmith | none
# PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
# LANGSMITH_API_KEY=

# --- API security (Phase 2) ---
# API_KEY=                                        # required when ENVIRONMENT=aws
